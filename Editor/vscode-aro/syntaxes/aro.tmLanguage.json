{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ARO",
  "scopeName": "source.aro",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#featureset"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#status-codes"
    },
    {
      "include": "#actions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#prepositions"
    },
    {
      "include": "#articles"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.aro",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        }
      ]
    },
    "featureset": {
      "patterns": [
        {
          "name": "meta.featureset.aro",
          "begin": "\\(([^:]+):\\s*([^)<]+?)(\\s+Handler|\\s+Observer)?(<[^>]+>)?\\s*\\)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.featureset.aro"
            },
            "2": {
              "name": "entity.name.type.business-activity.aro"
            },
            "3": {
              "name": "storage.type.handler.aro"
            },
            "4": {
              "name": "meta.state-guard.aro",
              "patterns": [
                {
                  "include": "#state-guard"
                }
              ]
            }
          },
          "end": "(?=\\()|$",
          "patterns": [
            {
              "include": "#featureset-body"
            }
          ]
        }
      ]
    },
    "state-guard": {
      "patterns": [
        {
          "match": "<([a-zA-Z][a-zA-Z0-9-]*)(?::([^,>]+))?>",
          "captures": {
            "1": {
              "name": "variable.other.aro"
            },
            "2": {
              "name": "constant.other.aro"
            }
          }
        }
      ]
    },
    "featureset-body": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#status-codes"
            },
            {
              "include": "#actions"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#prepositions"
            },
            {
              "include": "#articles"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "actions": {
      "patterns": [
        {
          "name": "keyword.action.request.aro",
          "match": "\\b(Ask|Choose|Clone|Exists|Extract|Fetch|Find|Get|Http|List|Load|Parse|Probe|Prompt|Pull|Read|Receive|Request|Retrieve|Select|Stat|Stream|Subscribe)\\b",
          "comment": "REQUEST actions - data coming IN (23 verbs, generated)"
        },
        {
          "name": "keyword.action.own.aro",
          "match": "\\b(Accept|Aggregate|Arrange|Assert|Attach|Build|Calculate|Call|Change|Check|Checkout|Clear|Combine|Compare|Compute|Configure|Construct|Convert|Create|Declare|Delay|Delete|Derive|Destroy|Embed|Exec|Execute|Filter|Flip|Given|Group|Include|Insert|Invoke|Join|Map|Match|Merge|Modify|Order|ParseHtml|Parsehtml|Pause|Reduce|Remove|Reverse|Run|Set|Shell|Show|Sleep|Sort|Split|Stage|Then|Transform|Update|Validate|Verify|When)\\b",
          "comment": "OWN actions - internal processing (60 verbs, generated)"
        },
        {
          "name": "keyword.action.response.aro",
          "match": "\\b(Alert|Append|Broadcast|Debug|Dispatch|Fail|Log|Notify|Output|Patch|Persist|Print|Raise|Render|Repaint|Respond|Return|Save|Send|Signal|Store|Throw|Write)\\b",
          "comment": "RESPONSE actions - data going OUT (23 verbs, generated)"
        },
        {
          "name": "keyword.action.export.aro",
          "match": "\\b(Commit|Emit|Export|Expose|Publish|Push|Schedule|Share|Tag)\\b",
          "comment": "EXPORT actions - persistence/external (9 verbs, generated)"
        },
        {
          "name": "keyword.action.lifecycle.aro",
          "match": "\\b(Await|Block|Close|Connect|Copy|CreateDirectory|Createdirectory|Disconnect|Keepalive|Listen|Make|Mkdir|Move|Rename|Start|Stop|Terminate|Touch|Wait)\\b",
          "comment": "SERVER actions - lifecycle and services (19 verbs, generated)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.aro",
          "match": "<[a-zA-Z][a-zA-Z0-9-]*(:\\s*[a-zA-Z][a-zA-Z0-9-]*)?>",
          "comment": "Variables with optional qualifier - entire <var> or <var: qual> is one token"
        }
      ]
    },
    "status-codes": {
      "patterns": [
        {
          "name": "support.constant.status.aro",
          "match": "<(OK|Created|Accepted|NoContent|BadRequest|Unauthorized|Forbidden|NotFound|Error|InternalError):[ ]*status>"
        }
      ]
    },
    "prepositions": {
      "patterns": [
        {
          "name": "keyword.other.preposition.aro",
          "match": "\\b(from|to|with|for|into|on|where|against|as)\\b"
        }
      ]
    },
    "articles": {
      "patterns": [
        {
          "name": "keyword.other.article.aro",
          "match": "\\b(the|a|an)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aro",
          "match": "\\b(match|when|for|each|in|if|else|repeat|until|while)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aro",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aro",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.aro",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.aro",
          "match": "(==|!=|<=|>=)"
        },
        {
          "name": "keyword.operator.arithmetic.aro",
          "match": "\\+\\+|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.aro",
          "match": "(?<![<>])=(?![=])"
        },
        {
          "name": "keyword.operator.logical.aro",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    }
  },
  "comment": "The `actions` patterns are generated from the runtime action registry by Scripts/generate-editor-grammars.py — do not hand-edit them, run the script."
}
