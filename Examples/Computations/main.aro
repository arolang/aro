(* ============================================================
   Computations Example
   Demonstrates built-in compute operations and the
   qualifier-as-name syntax for naming computed results
   ============================================================ *)

(Application-Start: Computation Demo) {
    Log "=== ARO Computations Demo ===" to the <console>.

    (* --------------------------------------------------------
       String Length Operations
       Using qualifier-as-name to get distinct variable names
       -------------------------------------------------------- *)
    Create the <greeting> with "Hello, World!".
    Create the <farewell> with "Goodbye!".

    (* Old syntax: variable name IS the operation *)
    Compute the <length> from the <greeting>.
    Log "Greeting length (old syntax): " to the <console>.
    Log <length> to the <console>.

    (* New syntax: variable name and operation are separate *)
    Compute the <greeting-length: length> from the <greeting>.
    Compute the <farewell-length: length> from the <farewell>.
    Log "Greeting length (new syntax): " to the <console>.
    Log <greeting-length> to the <console>.
    Log "Farewell length: " to the <console>.
    Log <farewell-length> to the <console>.

    (* --------------------------------------------------------
       Case Transformations
       -------------------------------------------------------- *)
    Create the <mixedText> with "Hello ARO Developer".

    Compute the <upperText: uppercase> from the <mixedText>.
    Compute the <lowerText: lowercase> from the <mixedText>.

    Log "Original: " to the <console>.
    Log <mixedText> to the <console>.
    Log "Uppercase: " to the <console>.
    Log <upperText> to the <console>.
    Log "Lowercase: " to the <console>.
    Log <lowerText> to the <console>.

    (* --------------------------------------------------------
       Hashing
       -------------------------------------------------------- *)
    Create the <password> with "secret123".
    Compute the <password-hash: hash> from the <password>.
    Log "Password hash: " to the <console>.
    Log <password-hash> to the <console>.

    (* --------------------------------------------------------
       Arithmetic Computations
       -------------------------------------------------------- *)
    Create the <price> with 100.
    Create the <quantity> with 3.

    Compute the <subtotal> from <price> * <quantity>.
    Compute the <tax> from <subtotal> * 0.08.
    Compute the <total> from <subtotal> + <tax>.

    Log "Price: " to the <console>.
    Log <price> to the <console>.
    Log "Quantity: " to the <console>.
    Log <quantity> to the <console>.
    Log "Subtotal: " to the <console>.
    Log <subtotal> to the <console>.
    Log "Tax (8%): " to the <console>.
    Log <tax> to the <console>.
    Log "Total: " to the <console>.
    Log <total> to the <console>.

    (* --------------------------------------------------------
       Collection Counting
       -------------------------------------------------------- *)
    Create the <items> with ["apple", "banana", "cherry", "date"].
    Compute the <item-count: count> from the <items>.
    Log "Number of items: " to the <console>.
    Log <item-count> to the <console>.

    (* --------------------------------------------------------
       Collection & text qualifiers (GitLab #486)
       -------------------------------------------------------- *)
    Create the <amounts> with [10, 20, 12].
    Compute the <total-amount: sum> from the <amounts>.
    Log "Sum of amounts: " to the <console>.
    Log <total-amount> to the <console>.

    Compute the <mean-amount: avg> from the <amounts>.
    Log "Average amount: " to the <console>.
    Log <mean-amount> to the <console>.

    Create the <tags> with ["aro", "dsl", "aro", "runtime", "dsl"].
    Compute the <distinct-tags: unique> from the <tags>.
    Log "Distinct tags: " to the <console>.
    Compute the <tag-line: join> from the <distinct-tags> with { separator: ", " }.
    Log <tag-line> to the <console>.

    (* `lines` drops the trailing newline's phantom element, so the
       count is 3 rather than 4 — no `trim` needed first. *)
    Create the <document> with "first\nsecond\nthird\n".
    Compute the <document-lines: lines> from the <document>.
    Compute the <line-count: length> from the <document-lines>.
    Log "Line count: " to the <console>.
    Log <line-count> to the <console>.

    Compute the <digest: sha256> from "abc".
    Log "SHA-256 of abc: " to the <console>.
    Log <digest> to the <console>.

    Log "=== Demo Complete ===" to the <console>.

    Return an <OK: status> for the <demo>.
}
