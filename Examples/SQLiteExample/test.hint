# Test hints for SQLiteExample
# Package plugin compilation requires Swift compiler at runtime
# SQLite.swift library doesn't compile on Windows (no SQLite3 module available)
skip-on-windows: SQLite.swift library requires SQLite3 module not available on Windows
timeout: 300
#
# Both modes (GitLab #884 acceptance test). The expected output used to be the
# banner line alone with a note that the plugin might not load, so the test
# passed whether the plugin worked or not; pinning the real output (#820)
# showed the compiled binary failing at its first plugin action. It was the
# build skipping the plugin outright -- this package ships no `plugin.yaml`,
# and the static-link step read a missing manifest as "no native code" -- so
# the binary carried none of its symbols. Fixed in `PluginCompiler`, and this
# example is the thing that proves it.
mode: both
# Use occurrence-check for cross-platform compatibility (dictionary ordering varies)
occurrence-check: true
